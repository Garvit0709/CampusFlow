
# CampusFlow Backend Configuration

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=campusflow_db
DB_USER=postgres
DB_PASSWORD=

# JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Environment
APP_ENV=development
DEBUG=false

# Allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development

# Allowed frontend origins, separated by commas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production example:
# CORS_ORIGINS=https://your-campusflow-domain.vercel.app